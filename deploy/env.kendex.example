# Agrega / cambia estas variables en tu .env (y en .env.example)
APP_NAME=Kendex
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_DO
APP_TIMEZONE=UTC
KENDEX_TIMEZONE=America/Santo_Domingo

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kendex
DB_USERNAME=kendex
DB_PASSWORD=secret

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1

BCRYPT_ROUNDS=12

# Comprobantes: local en desarrollo; s3 en producción (AWS S3 / DigitalOcean Spaces / MinIO)
KENDEX_RECEIPTS_DISK=local
# FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=kendex-receipts
# AWS_ENDPOINT=http://127.0.0.1:9000      # MinIO en desarrollo
# AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@kendex.example.com
MAIL_FROM_NAME=Kendex

KENDEX_COMPANY="SOLOCAR, S.R.L."
KENDEX_CONTACT_EMAIL=privacidad@kendex.example.com
KENDEX_REGISTRATION=true
GA4_MEASUREMENT_ID=            # G-XXXXXXXXXX (solo se carga si la persona acepta cookies)
